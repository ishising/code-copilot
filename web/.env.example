# Which Cosmo installation your API key belongs to. app.askcosmo.ai and
# platform.askcosmo.ai are separate installations with separate workspaces
# — a key from one is rejected by the other with a 401 that reads like a
# bad key. Check yours at {host}/api/v1/external/realtime/verify.
VITE_COSMO_BASE_URL=https://platform.askcosmo.ai

# A Cosmo API key with the realtime:use scope.
# Developer platform -> API keys, in the Cosmo web app at app.askcosmo.ai.
VITE_COSMO_API_KEY=cosmo_...

# Optional. Without it GitHub allows 60 requests an hour, which is enough for
# a few repos; with it, 5000. Required to read a private repository.
#
# Use a FINE-GRAINED token (github_pat_...) with Contents: Read-only, scoped to
# the repos you care about. Two traps: a classic token's `public_repo` scope
# grants WRITE, and many orgs reject fine-grained tokens whose lifetime is over
# 366 days — so keep the expiry short (30 days is plenty).
# VITE_GITHUB_TOKEN=github_pat_...
